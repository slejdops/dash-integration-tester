# DASH Configuration
DASH_URL=https://dash.example.com:9443
DASH_ROLE_ENDPOINT=/dash/api/roles

# SSL Configuration
# Set to 'true' for production with valid certificates
# Set to 'false' for testing with self-signed certificates
VERIFY_SSL=false

# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=false
PORT=5000
